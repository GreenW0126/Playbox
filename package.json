{
  "name": "playbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:public": "vite --host 127.0.0.1 --mode public",
    "build": "npm run build:public",
    "build:local": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@xstate/react": "^6.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xstate": "^5.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
